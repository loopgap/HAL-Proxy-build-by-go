# ==========================================
# BridgeOS .gitignore
# ==========================================

# === Go ===
# Binaries
/bridge
/bridgeosd
/bridge.exe
/bridgeosd.exe
/hal
/hal-proxy
/hal.exe
/hal-proxy.exe
*.exe
bin/
*.test

# Dependencies (except go.mod and go.sum)
/vendor/

# Build outputs
*.out

# === Database ===
# Local SQLite database
bridgeos.db
hal-proxy.db
*.db
*.db-shm
*.db-wal

# === Artifacts ===
artifacts/*.md
artifacts/*.json
artifacts/*.html
!artifacts/.gitkeep

# === Frontend (React/TypeScript) ===
# Dependencies
ui/node_modules/
ui/dist/
ui/dist-ssr/

# Environment files
ui/.env
ui/.env.local
ui/.env.development
ui/.env.production
ui/.env.*.local

# Logs
ui/npm-debug.log*
ui/yarn-debug.log*
ui/yarn-error.log*
ui/pnpm-debug.log*

# Editor directories
ui/.DS_Store
ui/Thumbs.db

# === IDE ===
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# === OS ===
.DS_Store
Thumbs.db
desktop.ini

# === Logs ===
*.log
logs/
*.log.*
otel-exporter.log

# === Coverage ===
coverage/
coverage
coverage_go.out
coverage.out
coverage.html
*.cover

# === Temporary ===
*.tmp
.tmp/
*.bak
*.orig
*.old
release/
.gocache/
.tmp-smoke/

# === Secrets ===
*.pem
*.key
*.crt
secrets/

# === Build ===
build/
dist/
out/

# === Sisyphus (Planning/Execution) ===
.sisyphus/
!/.sisyphus/.gitkeep

# === Evidence / QA Results ===
.sisyphus/evidence/
*.evidence.*

# === Test Results ===
ui/test-results/
*.test.results.xml

# === Playwright ===
ui/playwright-report/
ui/.playwright/
